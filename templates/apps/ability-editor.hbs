{{!-- The ability editor (docs/29-user-interface.md §29.6).

      The tool §29.6 says decides whether SC-6 is met -- a GM authors a
      Karna-complexity Servant in under an hour. It could not set an ability's
      name.

      The targeting pickers are grids of fixed-size tiles. They were flex-wrap
      over unconstrained <pre> blocks, so a wide schematic overflowed its button
      and landed on the labels of the row beneath. --}}
<div class="fgt-editor">

  {{!-- The rail. Ordered top-to-bottom for a first author working through a
        sheet; every row is a jump, for someone fixing one cooldown on a
        shipped Servant. `state` says done / partial / empty and `count` says
        how much a list section holds, so a GM can see there is something in
        a section without opening it. --}}
  <nav class="fgt-editor__rail">
    {{#each rail as |row|}}
      <button type="button" class="fgt-editor__railrow fgt-editor__railrow--{{row.state}} {{#if row.current}}fgt-editor__railrow--current{{/if}}"
              data-action="jumpTo" data-section="{{row.id}}"
              data-tooltip="{{localize row.hint}}">
        <span class="fgt-editor__railmark"></span>
        <span class="fgt-editor__raillabel">{{localize row.label}}</span>
        {{#if row.count}}<span class="fgt-editor__railcount">{{row.count}}</span>{{/if}}
      </button>
    {{/each}}
  </nav>

  <div class="fgt-editor__body">

    <section class="fgt-editor__section" data-section-body="whatItIs">
      <h3 class="fgt-editor__heading">{{localize "FGT.Editor.Identity"}}</h3>
      <div class="fgt-editor__grid">
        <img class="fgt-editor__icon" src="{{identity.img}}" alt="{{identity.name}}"
             data-action="editImage" data-tooltip="{{localize 'FGT.Editor.Icon'}}">
        <label class="fgt-editor__field fgt-editor__field--wide">
          <span>{{localize "FGT.Editor.Name"}}</span>
          {{!-- On the Item, not in `system` -- held until Save with the rest
                of the draft, so nothing is written by typing. --}}
          <input type="text" name="name" value="{{identity.name}}">
        </label>
        <label class="fgt-editor__field">
          <span>{{localize "FGT.Editor.Kind"}}</span>
          <select name="kind">{{selectOptions identity.kindChoices selected=identity.kind localize=true}}</select>
        </label>
        <label class="fgt-editor__field">
          <span>{{localize "FGT.Editor.Rank"}}</span>
          <input type="text" name="rank" value="{{draft.rank}}">
        </label>
      </div>

      <label class="fgt-editor__field fgt-editor__field--block">
        <span>{{localize "FGT.Editor.Description"}}</span>
        <textarea name="description" rows="4">{{identity.description}}</textarea>
      </label>
    </section>

    <section class="fgt-editor__section" data-section-body="limits">
      <h3 class="fgt-editor__heading">{{localize "FGT.Editor.Limits"}}</h3>
      <div class="fgt-editor__grid">
        <label class="fgt-editor__field">
          <span>{{localize "FGT.Editor.Duration"}}</span>
          <input type="text" name="duration" value="{{draft.duration}}">
          {{#if durationHint}}
            {{!-- Tick arithmetic is what authors get wrong and the notation
                  gives no hint, so the field explains itself as you type. --}}
            <span class="fgt-editor__hint">{{durationHint}}</span>
          {{/if}}
        </label>
        <label class="fgt-editor__field">
          <span>{{localize "FGT.Editor.Cooldown"}}</span>
          <input type="text" name="cooldown.max" value="{{limits.cooldown}}">
          {{#if limits.cooldownHint}}
            <span class="fgt-editor__hint">{{limits.cooldownHint}}</span>
          {{/if}}
        </label>
        <label class="fgt-editor__field">
          <span>{{localize "FGT.Editor.Cost"}}</span>
          <input type="number" name="cost" value="{{limits.cost}}" min="1">
        </label>
        <label class="fgt-editor__field">
          <span>{{localize "FGT.Editor.MaxUses"}}</span>
          <input type="number" name="maxUses" value="{{limits.maxUses}}"
                 placeholder="{{localize 'FGT.Editor.Unlimited'}}">
        </label>
        <label class="fgt-editor__field">
          <span>{{localize "FGT.Editor.RequiresRound"}}</span>
          <input type="number" name="requiresRound" value="{{limits.requiresRound}}">
        </label>
        <label class="fgt-editor__field">
          <span>{{localize "FGT.Editor.Category"}}</span>
          <input type="text" name="category" value="{{limits.category}}">
        </label>
      </div>

      <div class="fgt-editor__flags">
        <label><input type="checkbox" name="oncePerTurn" {{checked limits.oncePerTurn}}>
          {{localize "FGT.Editor.OncePerTurn"}}</label>
        <label><input type="checkbox" name="isPassive" {{checked limits.isPassive}}>
          {{localize "FGT.Editor.IsPassive"}}</label>
        <label><input type="checkbox" name="isMode" {{checked limits.isMode}}>
          {{localize "FGT.Editor.IsMode"}}</label>
        <label><input type="checkbox" name="isAttackSkill" {{checked limits.isAttackSkill}}>
          {{localize "FGT.Editor.IsAttackSkill"}}</label>
      </div>
    </section>

    <details class="fgt-editor__advanced" data-section-body="npScoping">
      <summary>{{localize "FGT.Editor.Advanced"}}</summary>
      <p class="fgt-editor__hint">{{localize "FGT.Editor.AdvancedHint"}}</p>
      <div class="fgt-editor__flags">
        <label><input type="checkbox" name="isNP" {{checked advanced.isNP}}>
          {{localize "FGT.Editor.IsNP"}}</label>
        <label><input type="checkbox" name="categorizedAsNP" {{checked advanced.categorizedAsNP}}>
          {{localize "FGT.Editor.CategorizedAsNP"}}</label>
        <label><input type="checkbox" name="countsForNPSeal" {{checked advanced.countsForNPSeal}}>
          {{localize "FGT.Editor.CountsForNPSeal"}}</label>
      </div>
    </details>

    {{!-- WHEN IT FIRES. `timing.window` is authored by 117 of 195 abilities
          and had no control at all. --}}
    <section class="fgt-editor__section" data-section-body="whenItFires">
      <h3 class="fgt-editor__heading">{{localize "FGT.Authoring.Section.whenItFires"}}</h3>
      <p class="fgt-editor__hint">{{localize "FGT.Authoring.Section.whenItFiresHint"}}</p>

      <div class="fgt-editor__windows">
        {{#each timing.choices as |w|}}
          <label class="fgt-editor__window" data-tooltip="{{localize w.hint}}">
            {{!-- Checkboxes, not a dropdown: an ability may name TWO windows.
                  Karna's Uncrowned Arms Mastership is "during your Turn or at
                  the start of a Combat Phase". --}}
            <input type="checkbox" name="window.{{w.id}}" {{#if w.chosen}}checked{{/if}}>
            <span>{{localize w.label}}</span>
            {{#unless w.dispatched}}
              <em class="fgt-editor__note">{{localize "FGT.Authoring.Window.documentary"}}</em>
            {{/unless}}
          </label>
        {{/each}}
      </div>

      <div class="fgt-editor__grid">
        {{#each timing.fields as |row|}}{{> fgt-editor-field row}}{{/each}}
      </div>
    </section>

    {{!-- REQUIREMENTS. An unmet one refuses; an UNKNOWN one always refuses,
          which is why the picker only offers what the dispatcher answers. --}}
    <section class="fgt-editor__section" data-section-body="requirements" data-requirements>
      <h3 class="fgt-editor__heading">{{localize "FGT.Authoring.Section.requirements"}}</h3>
      <p class="fgt-editor__hint">{{localize "FGT.Authoring.Section.requirementsHint"}}</p>

      {{#each requirements.rows as |r|}}
        <div class="fgt-editor__entry {{#if r.unknown}}fgt-editor__entry--unknown{{/if}}">
          <header class="fgt-editor__entryhead">
            <span class="fgt-editor__entryname" data-tooltip="{{localize r.hint}}">
              {{#if r.unknown}}{{r.kind}}{{else}}{{localize r.label}}{{/if}}
            </span>
            <button type="button" data-action="removeRequirement" data-index="{{r.index}}">✕</button>
          </header>
          {{#if r.unknown}}
            <textarea name="requirements.{{r.index}}.raw" rows="3">{{r.raw}}</textarea>
          {{else}}
            <div class="fgt-editor__grid">
              {{#each r.fields as |row|}}{{> fgt-editor-field row}}{{/each}}
            </div>
          {{/if}}
        </div>
      {{/each}}

      <div class="fgt-editor__add">
        <select data-picker>
          {{#each requirements.choices as |c|}}
            <option value="{{c.id}}">{{localize c.label}}</option>
          {{/each}}
        </select>
        <button type="button" data-action="addRequirement">
          {{localize "FGT.Authoring.Add"}}
        </button>
      </div>
    </section>

    {{!-- RULE ELEMENTS. The section that has never existed: the editor
          VALIDATED these three buckets and offered no control that could add
          one. Achilles's whole passive half was unauthorable. --}}
    <section class="fgt-editor__section" data-section-body="ruleElements">
      <h3 class="fgt-editor__heading">{{localize "FGT.Authoring.Section.ruleElements"}}</h3>
      <p class="fgt-editor__hint">{{localize "FGT.Authoring.Section.ruleElementsHint"}}</p>

      {{#each buckets as |b|}}
        <div class="fgt-editor__bucket" data-bucket="{{b.id}}">
          <h4 class="fgt-editor__subheading" data-tooltip="{{localize b.hint}}">
            {{localize b.label}}
          </h4>

          {{#each b.rows as |e|}}
            <div class="fgt-editor__entry {{#if e.unknown}}fgt-editor__entry--unknown{{/if}}">
              <header class="fgt-editor__entryhead">
                <span class="fgt-editor__entryname" data-tooltip="{{localize e.hint}}">
                  {{#if e.unknown}}{{e.key}}{{else}}{{localize e.label}}{{/if}}
                </span>
                <button type="button" data-action="moveElement" data-bucket="{{b.id}}"
                        data-index="{{e.index}}" data-direction="up">↑</button>
                <button type="button" data-action="moveElement" data-bucket="{{b.id}}"
                        data-index="{{e.index}}" data-direction="down">↓</button>
                <button type="button" data-action="removeElement" data-bucket="{{b.id}}"
                        data-index="{{e.index}}">✕</button>
              </header>

              {{#if e.unknown}}
                {{!-- §21.4: a module may add a rule element. Keeping it raw is
                      what stops the editor deleting another package's content
                      on the next Save. --}}
                <p class="fgt-editor__note">{{localize "FGT.Authoring.UnknownElement"}}</p>
                <textarea name="{{b.id}}.{{e.index}}.raw" rows="4">{{e.raw}}</textarea>
              {{else}}
                <div class="fgt-editor__grid">
                  {{#each e.fields as |row|}}{{> fgt-editor-field row}}{{/each}}
                </div>
              {{/if}}
            </div>
          {{/each}}

          <div class="fgt-editor__add">
            <select data-picker>
              {{#each b.choices as |c|}}
                <option value="{{c.id}}">{{localize c.label}}</option>
              {{/each}}
            </select>
            <button type="button" data-action="addElement" data-bucket="{{b.id}}">
              {{localize "FGT.Authoring.Add"}}
            </button>
          </div>
        </div>
      {{/each}}
    </section>

    {{!-- The piece §29.6 says matters most: diagrams, not internal names. --}}
    <section class="fgt-editor__section" data-section-body="whereItLands">
      <h3 class="fgt-editor__heading">{{localize "FGT.Editor.Anchor"}}</h3>
      <div class="fgt-editor__picker">
        {{#each anchors as |a|}}
          <button type="button" data-action="pickAnchor" data-anchor-id="{{a.id}}"
                  class="fgt-editor__option {{#if a.selected}}fgt-editor__option--on{{/if}}"
                  data-tooltip="{{localize a.hint}}">
            <span class="fgt-editor__diagram">{{{a.svg}}}</span>
            <span class="fgt-editor__label">{{localize a.label}}</span>
          </button>
        {{/each}}
      </div>

      <h3 class="fgt-editor__heading">{{localize "FGT.Editor.Shape"}}</h3>
      <div class="fgt-editor__picker">
        {{#each shapes as |s|}}
          <button type="button" data-action="pickShape" data-shape-id="{{s.id}}"
                  class="fgt-editor__option {{#if s.selected}}fgt-editor__option--on{{/if}}"
                  data-tooltip="{{localize s.hint}}">
            <span class="fgt-editor__diagram">{{{s.svg}}}</span>
            <span class="fgt-editor__label">{{localize s.label}}</span>
          </button>
        {{/each}}
      </div>

      {{!-- WHO inside the area is caught. The anchor and the shape had a
            picker and this had nothing, so Akhilleus Kosmos's "allied Units,
            including himself" could not be said. --}}
      <h3 class="fgt-editor__heading">{{localize "FGT.Authoring.Selection.heading"}}</h3>
      <div class="fgt-editor__grid">
        {{#each selection.fields as |row|}}{{> fgt-editor-field row}}{{/each}}
      </div>
    </section>

    <section class="fgt-editor__section" data-section-body="whatItDoes">
      <h3 class="fgt-editor__heading">{{localize "FGT.Editor.Phases"}}</h3>
      <p class="fgt-editor__hint">{{localize "FGT.Editor.PhasesHint"}}</p>

      {{#each phases as |p|}}
        <article class="fgt-editor__phase" data-index="{{p.index}}">
          <header class="fgt-editor__phasehead">
            <span class="fgt-editor__phaseno">{{p.index}}</span>
            {{!-- `selectOptions`, not a hand-rolled loop. Comparing `k` against
                  `../p.kind` across two nested {{#each}}es marked nothing
                  selected, so every dropdown showed the first kind
                  alphabetically beside the fields of the kind it really was.
                  An unrecognised kind is in `kindChoices` too, so selecting it
                  is possible and the next render cannot rewrite it. --}}
            <select name="phase.{{p.index}}.kind">
              {{selectOptions p.kindChoices selected=p.kind}}
            </select>
            <button type="button" data-action="movePhase" data-direction="up"
                    {{disabled p.isFirst}}>↑</button>
            <button type="button" data-action="movePhase" data-direction="down"
                    {{disabled p.isLast}}>↓</button>
            <button type="button" data-action="removePhase">✕</button>
          </header>

          {{!-- The same partial every other descriptor field uses, so a phase
                kind gains a typed control by being described rather than by
                anyone editing this file. --}}
          {{#each p.fields as |row|}}{{> fgt-editor-field row}}{{/each}}

          {{#each p.rules as |r|}}
            {{!-- The effect id is the field that decides whether an
                  applyEffects phase does anything at all, so it is a list of
                  registered effects rather than free text. --}}
            <div class="fgt-editor__rule">
              {{!-- `selectOptions` for the same reason the kind select uses it:
                    an `{{#if (eq …)}}` against a block param two {{#each}}es up
                    marks nothing selected, and a dropdown that always shows its
                    first entry is worse than a text box. --}}
              <select name="phase.{{p.index}}.rule.{{r.index}}.effectId">
                <option value="">—</option>
                {{selectOptions r.effectChoices selected=r.effectId}}
              </select>
              <input type="number" name="phase.{{p.index}}.rule.{{r.index}}.magnitude"
                     value="{{r.magnitude}}" data-tooltip="{{localize 'FGT.Editor.Magnitude'}}">
              <input type="text" name="phase.{{p.index}}.rule.{{r.index}}.duration"
                     value="{{r.duration}}" data-tooltip="{{localize 'FGT.Editor.Duration'}}">
            </div>
          {{/each}}

          <details class="fgt-editor__raw" {{#unless p.known}}open{{/unless}}>
            <summary>
              {{#if p.known}}
                {{localize "FGT.Editor.RawPhase"}}
              {{else}}
                {{localize "FGT.Editor.RawPhaseOnly"}}
              {{/if}}
            </summary>
            <textarea name="phase.{{p.index}}.raw" rows="6" spellcheck="false">{{p.raw}}</textarea>
          </details>
        </article>
      {{/each}}

      <button type="button" class="fgt-editor__add" data-action="addPhase">
        {{localize "FGT.Editor.AddPhase"}}
      </button>
    </section>
  </div>

  {{!-- Live validation, running the engine's own vocabularies. --}}
  <section class="fgt-editor__validation">
    {{#if valid}}
      <p class="fgt-editor__ok">{{localize "FGT.Editor.NoProblems"}}</p>
    {{else}}
      <h4>{{localize "FGT.Editor.Problems"}}</h4>
      <ul class="fgt-editor__problems">
        {{#each problems as |p|}}<li>{{p}}</li>{{/each}}
      </ul>
    {{/if}}
    {{#if warnings.length}}
      <h4>{{localize "FGT.Editor.Warnings"}}</h4>
      <ul class="fgt-editor__warnings">
        {{#each warnings as |w|}}<li>{{w}}</li>{{/each}}
      </ul>
    {{/if}}
  </section>

  <footer class="fgt-editor__footer">
    {{!-- Ch. 39: the pack is the truth, so an edit worth keeping needs a way
          back to `packs/_source/`. Not gated on `valid` -- half-finished work
          is exactly what a GM most wants to keep. --}}
    <button type="button" class="fgt-editor__export" data-action="exportSource">
      {{localize "FGT.Export.Action"}}
    </button>
    <button type="button" class="fgt-editor__save" data-action="save" {{disabled (not valid)}}>
      {{localize "FGT.Editor.Save"}}
    </button>
  </footer>
</div>
