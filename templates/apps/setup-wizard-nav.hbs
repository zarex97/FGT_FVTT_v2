{{!-- The tab rail. `data-action="tab"` is ApplicationV2's own action: the
      framework binds it, tracks the active tab and re-renders, and there is no
      click handler for it in `setup-wizard.mjs`.

      The `tabs` class and each pane's `.tab[data-group]` are not decoration --
      `changeTab` finds the nav with `closest(".tabs")` and the panes by that
      selector, so without both names the click binds and then toggles nothing. --}}
<nav class="tabs fgt-nav" data-group="primary" role="tablist">
  {{#each tabs as |tab|}}
    <a class="fgt-nav__item {{tab.cssClass}}" data-action="tab"
       data-group="{{tab.group}}" data-tab="{{tab.id}}"
       role="tab" aria-selected="{{tab.active}}"
       data-tooltip="{{localize tab.label}}" aria-label="{{localize tab.label}}">
      <i class="{{tab.icon}}"></i>
    </a>
  {{/each}}
</nav>
