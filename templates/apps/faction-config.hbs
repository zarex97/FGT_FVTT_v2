<div class="fgt-factions">
  <p class="fgt-factions__intro">{{localize "FGT.Factions.Intro"}}</p>

  {{#if isEmpty}}
    <p class="fgt-factions__empty">{{localize "FGT.Factions.Empty"}}</p>
  {{/if}}

  {{#each factions as |faction|}}
    <fieldset class="fgt-factions__row" data-faction-id="{{faction.id}}">
      <legend>
        <span class="fgt-factions__swatch" style="background: {{faction.color}}"></span>
        {{faction.name}}
        <code class="fgt-factions__id">{{faction.id}}</code>
      </legend>

      <div class="fgt-factions__fields">
        <label>
          <span>{{localize "FGT.Factions.Name"}}</span>
          <input type="text" name="factions.{{faction.id}}.name" value="{{faction.name}}">
        </label>

        <label>
          <span>{{localize "FGT.Factions.Color"}}</span>
          <input type="color" name="factions.{{faction.id}}.color" value="{{faction.color}}">
        </label>

      </div>

      {{!-- Checkboxes rather than a select: a faction holds a LIST of players.
            `faction.players` is built per row so each carries its own ticked
            state; a shared list would render every row identically. --}}
      <div class="fgt-factions__players">
        <span class="fgt-factions__players-label">{{localize "FGT.Factions.Players"}}</span>
        {{#if @root.hasPlayers}}
          {{#each faction.players as |player|}}
            <label class="fgt-factions__player">
              <input type="checkbox" name="factions.{{faction.id}}.userIds.{{player.id}}"
                     {{checked player.assigned}}>
              <span>{{player.name}}</span>
            </label>
          {{/each}}
        {{else}}
          <span class="fgt-factions__none">{{localize "FGT.Factions.NoPlayers"}}</span>
        {{/if}}
      </div>

      {{#if faction.others.length}}
        <div class="fgt-factions__allies">
          <span class="fgt-factions__allies-label">{{localize "FGT.Factions.Allies"}}</span>
          {{#each faction.others as |other|}}
            <label class="fgt-factions__ally">
              {{!-- `faction` is a block param, so it stays in scope inside this
                    nested each; `../faction` would be a context lookup. --}}
              <input type="checkbox" name="factions.{{faction.id}}.allies.{{other.id}}"
                     {{checked other.allied}}>
              <span>{{other.name}}</span>
            </label>
          {{/each}}
        </div>
      {{/if}}

      <button type="button" class="fgt-factions__delete" data-action="deleteFaction">
        {{localize "FGT.Factions.Delete"}}
      </button>
    </fieldset>
  {{/each}}

  <footer class="fgt-factions__footer">
    <button type="button" data-action="addFaction">{{localize "FGT.Factions.Add"}}</button>
  </footer>
</div>
