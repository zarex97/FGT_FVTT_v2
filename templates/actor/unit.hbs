{{!-- Only helpers Foundry v14 actually registers are used here: localize,
      concat, ifThen, disabled and selectOptions. `array` and `upper` do not
      exist and would throw at render.

      NOT a <form>. ApplicationV2 renders the sheet's frame AS the form element
      (`tag: "form"`), and a part's HTML is parsed detached, so a <form> here
      really does become a nested one. Every input would then have the INNER
      form as its owner, `FormDataExtended(outerForm)` would collect nothing,
      and no edit on this sheet would ever save. --}}
<div class="fgt-sheet">
  <header class="fgt-sheet__header">
    <img class="fgt-sheet__portrait" src="{{document.img}}" alt="{{document.name}}" data-edit="img">
    <div class="fgt-sheet__identity">
      <input type="text" name="name" value="{{document.name}}" placeholder="{{localize 'FGT.Sheet.Name'}}">
      {{#if system.trueName}}<p class="fgt-sheet__truename">{{system.trueName}}</p>{{/if}}
      {{!-- Targeting resolves relations from this. A Unit with no faction is
            "neutral" to everyone, which is why an unset faction makes every
            attack report that it has no legal targets. --}}
      <label class="fgt-sheet__faction">
        <span>{{localize "FGT.Sheet.Faction"}}</span>
        <select name="system.factionId">
          <option value="">{{localize "FGT.Sheet.NoFaction"}}</option>
          {{selectOptions factionChoices selected=system.factionId}}
        </select>
      </label>
      {{#unless hasFaction}}
        <p class="fgt-sheet__hint">
          {{#if hasFactions}}
            {{localize "FGT.Sheet.NoFactionHint"}}
          {{else}}
            {{localize "FGT.Sheet.NoFactionsAtAll"}}
          {{/if}}
        </p>
      {{/unless}}
    </div>
  </header>

  <section class="fgt-sheet__resources">
    <label class="fgt-resource">
      <span>{{localize "FGT.Resource.health"}}</span>
      <input type="number" name="system.health.value" value="{{system.health.value}}">
      <span class="fgt-resource__sep">/</span>
      <input type="number" name="system.health.max" value="{{system.health.max}}">
    </label>
    <label class="fgt-resource">
      <span>{{localize "FGT.Resource.agility"}}</span>
      <input type="number" name="system.agility.value" value="{{system.agility.value}}">
      <span class="fgt-resource__sep">/</span>
      <input type="number" name="system.agility.max" value="{{system.agility.max}}">
    </label>
    <label class="fgt-resource">
      <span>{{localize "FGT.Resource.luck"}}</span>
      <input type="number" name="system.luck.value" value="{{system.luck.value}}">
      <span class="fgt-resource__sep">/</span>
      <input type="number" name="system.luck.max" value="{{system.luck.max}}">
    </label>
  </section>

  {{#if system.parameters}}
    <section class="fgt-sheet__parameters">
      {{#each system.parameters as |rank key|}}
        <label class="fgt-parameter">
          <span>{{localize (concat "FGT.Param." key)}}</span>
          <input type="text" name="system.parameters.{{key}}" value="{{rank}}" placeholder="—">
        </label>
      {{/each}}
    </section>
  {{/if}}

  <section class="fgt-sheet__actions">
    <button type="button" class="fgt-sheet__attack" data-action="normalAttack">
      {{localize "FGT.Sheet.NormalAttack"}}
    </button>
  </section>

  <section class="fgt-sheet__abilities">
    <h3>{{localize "FGT.Sheet.Abilities"}}</h3>
    <ul class="fgt-list">
      {{#each abilities as |ability|}}
        <li class="fgt-list__row fgt-list__row--{{ability.use.kind}}{{#if ability.active}} fgt-list__row--on{{/if}}" data-item-id="{{ability.id}}">
          {{#if ability.use.clickable}}
            <button type="button" class="fgt-list__name" data-action="{{ability.use.action}}"
                    {{disabled ability.locked}}
                    data-tooltip="{{localize (concat 'FGT.Use.' ability.use.kind)}}">
              {{ability.name}}
            </button>
          {{else}}
            {{!-- A passive is not a control. It is always on and has nothing to press. --}}
            <span class="fgt-list__name fgt-list__name--passive">{{ability.name}}</span>
          {{/if}}
          {{#if ability.use.toggles}}
            <span class="fgt-list__state">{{localize (concat "FGT.Mode." (ifThen ability.active "on" "off"))}}</span>
          {{/if}}
          {{#if ability.rank}}<span class="fgt-list__rank">{{ability.rank}}</span>{{/if}}
          <button type="button" class="fgt-list__edit" data-action="editAbility" data-tooltip="{{localize 'FGT.Sheet.Edit'}}">✎</button>
        </li>
      {{else}}
        <li class="fgt-list__empty">{{localize "FGT.Sheet.NoAbilities"}}</li>
      {{/each}}
    </ul>

    {{#if noblePhantasms.length}}
      <h3>{{localize "FGT.Sheet.NoblePhantasms"}}</h3>
      <ul class="fgt-list">
        {{#each noblePhantasms as |np|}}
          <li class="fgt-list__row fgt-list__row--np" data-item-id="{{np.id}}">
            <button type="button" class="fgt-list__name" data-action="{{np.use.action}}">{{np.name}}</button>
            {{#if np.rank}}<span class="fgt-list__rank">{{np.rank}}</span>{{/if}}
            <button type="button" class="fgt-list__edit" data-action="editAbility" data-tooltip="{{localize 'FGT.Sheet.Edit'}}">✎</button>
          </li>
        {{/each}}
      </ul>
    {{/if}}
  </section>

  {{#if system.notes}}
    <section class="fgt-sheet__notes">{{{system.notes}}}</section>
  {{/if}}
</div>
