{{!-- The Abilities tab (docs/29-user-interface.md §29.2).

      One card per ability, sorted class skills → personal skills → Noble
      Phantasms, which is the order every reference sheet prints them in.

      Every disabled control states its reason on the control (D29.2), and
      every irreversible action warns before the click rather than after. The
      state line and the cost both come from `canUseAbility` and `npCost` --
      the same calls `engine/attack.mjs` makes -- so what the card promises and
      what the resolution does cannot disagree. --}}
<section class="tab fgt-tab {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">

  {{#unless abilityCards.anyAbilities}}
    <p class="fgt-empty">{{localize "FGT.Sheet.NoAbilities"}}</p>
  {{/unless}}

  {{#if abilityCards.classSkills.length}}
    <h3 class="fgt-panel__title">{{localize "FGT.Sheet.ClassSkills"}}</h3>
    {{#each abilityCards.classSkills as |a|}}
      {{> fgt-ability-card a}}
    {{/each}}
  {{/if}}

  {{#if abilityCards.skills.length}}
    <h3 class="fgt-panel__title">{{localize "FGT.Sheet.PersonalSkills"}}</h3>
    {{#each abilityCards.skills as |a|}}
      {{> fgt-ability-card a}}
    {{/each}}
  {{/if}}

  {{#if abilityCards.noblePhantasms.length}}
    <h3 class="fgt-panel__title">{{localize "FGT.Sheet.NoblePhantasms"}}</h3>
    {{#each abilityCards.noblePhantasms as |a|}}
      {{> fgt-ability-card a}}
    {{/each}}
  {{/if}}
</section>
