{{!-- The Abilities tab (docs/29-user-interface.md §29.2). --}}
<section class="tab fgt-tab {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">

  <h3 class="fgt-panel__title">{{localize "FGT.Sheet.Abilities"}}</h3>
  <ul class="fgt-list">
    {{#each abilities as |ability|}}
      <li class="fgt-list__row fgt-list__row--{{ability.use.kind}}{{#if ability.active}} fgt-list__row--on{{/if}}"
          data-item-id="{{ability.id}}">
        {{#if ability.use.clickable}}
          <button type="button" class="fgt-list__name" data-action="{{ability.use.action}}"
                  {{disabled ability.locked}}
                  data-tooltip="{{localize (concat 'FGT.Use.' ability.use.kind)}}">
            {{ability.name}}
          </button>
        {{else}}
          {{!-- A passive is not a control. It is always on and has nothing to press. --}}
          <span class="fgt-list__name fgt-list__name--passive">{{ability.name}}</span>
        {{/if}}
        {{#if ability.use.toggles}}
          <span class="fgt-list__state">{{localize (concat "FGT.Mode." (ifThen ability.active "on" "off"))}}</span>
        {{/if}}
        {{#if ability.rank}}<span class="fgt-list__rank">{{ability.rank}}</span>{{/if}}
        <button type="button" class="fgt-list__edit" data-action="editAbility"
                data-tooltip="{{localize 'FGT.Sheet.Edit'}}">✎</button>
      </li>
    {{else}}
      <li class="fgt-list__empty">{{localize "FGT.Sheet.NoAbilities"}}</li>
    {{/each}}
  </ul>

  {{#if noblePhantasms.length}}
    <h3 class="fgt-panel__title">{{localize "FGT.Sheet.NoblePhantasms"}}</h3>
    <ul class="fgt-list">
      {{#each noblePhantasms as |np|}}
        <li class="fgt-list__row fgt-list__row--np" data-item-id="{{np.id}}">
          <button type="button" class="fgt-list__name" data-action="{{np.use.action}}">{{np.name}}</button>
          {{#if np.rank}}<span class="fgt-list__rank">{{np.rank}}</span>{{/if}}
          <button type="button" class="fgt-list__edit" data-action="editAbility"
                  data-tooltip="{{localize 'FGT.Sheet.Edit'}}">✎</button>
        </li>
      {{/each}}
    </ul>
  {{/if}}
</section>
