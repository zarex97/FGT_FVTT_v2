<div class="fgt-hud">
  <header class="fgt-hud__header">
    <span class="fgt-hud__faction">{{factionName}}</span>
    <span class="fgt-hud__clock">
      {{localize "FGT.HUD.TurnOfRound" turn=turn turnsPerRound=turnsPerRound round=round}}
    </span>
  </header>

  <section class="fgt-hud__pools">
    {{#each rows as |row|}}
      <div class="fgt-hud__pool">
        <span class="fgt-hud__pool-label">{{row.label}}</span>
        <span class="fgt-hud__pips">
          {{#each row.pips as |spent|}}
            <span class="fgt-hud__pip{{#if spent}} fgt-hud__pip--spent{{/if}}"></span>
          {{/each}}
        </span>
        <span class="fgt-hud__pool-count">{{row.used}} / {{row.max}}</span>
      </div>
    {{/each}}
  </section>

  {{#if units.length}}
    <section class="fgt-hud__units">
      {{#each units as |unit|}}
        <div class="fgt-hud__unit" data-action="panTo" data-unit-id="{{unit.id}}">
          <span class="fgt-hud__unit-name">{{unit.name}}</span>
          <span class="fgt-hud__unit-state">
            <span class="fgt-hud__badge{{#if unit.moved}} fgt-hud__badge--done{{/if}}">M</span>
            <span class="fgt-hud__badge{{#if unit.attacked}} fgt-hud__badge--done{{/if}}">A</span>
          </span>
          <span class="fgt-hud__unit-mov" title="{{unit.moveBlocked}}">
            {{unit.movementLeft}} / {{unit.mov}}
          </span>
        </div>
      {{/each}}
    </section>
  {{/if}}

  {{#if order.length}}
    {{!-- Delay is a public declaration, so the order is public too: a player
          weighing a delay needs to see who they would end up behind. --}}
    <section class="fgt-hud__order">
      {{#each order as |slot|}}
        <div class="fgt-hud__slot{{#if slot.active}} fgt-hud__slot--active{{/if}}{{#if slot.acted}} fgt-hud__slot--acted{{/if}}">
          <span class="fgt-hud__slot-name">{{slot.name}}</span>
          {{#if slot.delay}}<span class="fgt-hud__slot-delay">+{{slot.delay}}</span>{{/if}}
        </div>
      {{/each}}
    </section>
  {{/if}}

  {{#if unmet.length}}
    <section class="fgt-hud__warnings">
      {{#each unmet as |warning|}}
        <div class="fgt-hud__warning">
          <span class="fgt-hud__warning-icon">⚠</span>
          <span class="fgt-hud__warning-text">{{warning.message}}</span>
        </div>
      {{/each}}
    </section>
  {{/if}}

  {{#if isMyTurn}}
    {{#if delayChoices.length}}
      <section class="fgt-hud__delay">
        <label>
          <span>{{localize "FGT.HUD.Delay"}}</span>
          <select name="delay">
            {{#each delayChoices as |n|}}
              <option value="{{n}}" {{#if (eq n ../delay)}}selected{{/if}}>+{{n}}</option>
            {{/each}}
          </select>
        </label>
        <button type="button" data-action="delay" data-tooltip="{{localize 'FGT.HUD.DelayHint'}}">
          {{localize "FGT.HUD.DelayApply"}}
        </button>
      </section>
    {{/if}}

    <footer class="fgt-hud__footer">
      <button type="button" data-action="endTurn" {{disabled (not canEndTurn)}}>
        {{localize "FGT.HUD.EndTurn"}}
      </button>
      {{#unless canEndTurn}}
        <span class="fgt-hud__blocked">
          {{localize "FGT.HUD.Blocked" count=unmet.length}}
        </span>
      {{/unless}}
    </footer>
  {{/if}}
</div>
