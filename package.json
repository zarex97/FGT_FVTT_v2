{
  "name": "fgt-fvtt",
  "version": "0.0.1",
  "description": "Fate/Grail Tactics — a Foundry VTT v14 system with full rules automation",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit",
    "test:golden": "vitest run test/golden",
    "lint": "eslint module tools test",
    "typecheck": "tsc -p jsconfig.json",
    "validate:content": "node tools/validate-content.mjs",
    "build:packs": "node tools/build-packs.mjs",
    "build:styles": "sass styles/src/fgt.scss styles/fgt.css --no-source-map",
    "watch:styles": "sass --watch styles/src/fgt.scss styles/fgt.css",
    "check:manifest": "node tools/check-manifest.mjs",
    "check:release": "node tools/check-release.mjs",
    "release:stamp": "node tools/release.mjs",
    "build": "npm run build:packs && npm run build:styles"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@foundryvtt/foundryvtt-cli": "^3.0.4",
    "eslint": "^9.15.0",
    "sass": "^1.102.0",
    "vitest": "^2.1.0",
    "yaml": "^2.6.0"
  }
}
